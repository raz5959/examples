// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
// © ATR 50% / 100% Daily Levels

//@version=6
indicator("ATR 50/100 Daily Levels", overlay=true, max_lines_count=500)

// === Inputs ===
atrLength    = input.int(14, "ATR Period", minval=1)
atrType      = input.string("SMA", "ATR Type", options=["RMA", "SMA"])
lineWidth    = input.int(2, "Line Width", minval=1, maxval=4)
atr50Color   = input.color(color.new(color.yellow, 0), "50% ATR Color")
atr100Color  = input.color(color.new(color.red, 0), "100% ATR Color")
ma20Color    = input.color(color.new(color.orange, 0), "MA 20 Color")
ma200Color   = input.color(color.new(color.purple, 0), "MA 200 Color")
riskAmount   = input.float(100, "Risk Amount ($)", minval=1)

// === Daily Data ===
prevClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
dailyHigh = request.security(syminfo.tickerid, "D", high)
dailyLow  = request.security(syminfo.tickerid, "D", low)
dailyOpen = request.security(syminfo.tickerid, "D", open)
atrRMA    = request.security(syminfo.tickerid, "D", ta.atr(atrLength)[1], lookahead=barmerge.lookahead_on)
atrSMA    = request.security(syminfo.tickerid, "D", ta.sma(ta.tr(true), atrLength)[1], lookahead=barmerge.lookahead_on)
dailyATR  = atrType == "SMA" ? atrSMA : atrRMA

// === 5-Min Moving Averages ===
ma20_5m  = request.security(syminfo.tickerid, "5", ta.sma(close, 20))
ma200_5m = request.security(syminfo.tickerid, "5", ta.sma(close, 200))

// === First Candle of the Day ===
var float firstCandleHigh = na
var float firstCandleLow  = na
var float firstCandleSize = na

if newDay
    firstCandleHigh := high
    firstCandleLow  := low
    firstCandleSize := high - low

shares = firstCandleSize > 0 ? math.floor(riskAmount / firstCandleSize) : 0

// === ATR Levels (direction based on MA order) ===
halfATR        = dailyATR / 2.0
isBullish      = ma20_5m > ma200_5m
bearishGapUp   = not isBullish and dailyOpen > prevClose
bullishGapDown = isBullish and dailyOpen < prevClose
basePrice      = bearishGapUp ? dailyHigh : bullishGapDown ? dailyLow : prevClose
atr50          = isBullish ? basePrice + halfATR  : basePrice - halfATR
atr100         = isBullish ? basePrice + dailyATR : basePrice - dailyATR

// === ATR Lines (today only, update every bar) ===
var line line50  = na
var line line100 = na
var label lbl50  = na
var label lbl100 = na

if newDay
    if not na(line50)
        line.delete(line50)
    if not na(line100)
        line.delete(line100)
    line50  := line.new(bar_index, atr50,  bar_index + 1, atr50,  color=atr50Color,  width=lineWidth, extend=extend.right)
    line100 := line.new(bar_index, atr100, bar_index + 1, atr100, color=atr100Color, width=lineWidth, extend=extend.right)

// Update line y-values and labels every bar (for dynamic dailyHigh/dailyLow)
if not na(line50)
    line.set_y1(line50, atr50)
    line.set_y2(line50, atr50)
    line.set_color(line50, isBullish ? atr50Color : atr50Color)
if not na(line100)
    line.set_y1(line100, atr100)
    line.set_y2(line100, atr100)
if not na(lbl50)
    label.delete(lbl50)
if not na(lbl100)
    label.delete(lbl100)
lbl50  := label.new(bar_index + 5, atr50,  "50% " + str.tostring(atr50, format.mintick),  style=label.style_label_left, color=color.new(color.black, 100), textcolor=atr50Color,  size=size.normal)
lbl100 := label.new(bar_index + 5, atr100, "100% " + str.tostring(atr100, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=atr100Color, size=size.normal)

// === Plot MAs ===
plot(ma20_5m, "SMA 20 (5m)", color=ma20Color, linewidth=2)
plot(ma200_5m, "SMA 200 (5m)", color=ma200Color, linewidth=2)

// === Info Table ===
if barstate.islast
    var table t = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), border_width=1)
    table.cell(t, 0, 0, "Prev Close",   text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 0, str.tostring(prevClose, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 1, "ATR(" + str.tostring(atrLength) + ")", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, str.tostring(dailyATR, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "50% ATR",      text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 2, str.tostring(halfATR, format.mintick),  text_color=atr50Color, text_size=size.small)
    table.cell(t, 0, 3, "50% Level",    text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 3, str.tostring(atr50, format.mintick),    text_color=atr50Color, text_size=size.small)
    table.cell(t, 0, 4, "100% Level",   text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 4, str.tostring(atr100, format.mintick),   text_color=atr100Color, text_size=size.small)
    table.cell(t, 0, 5, "1st Candle",   text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 5, str.tostring(firstCandleSize, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 6, "Risk $",       text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 6, str.tostring(riskAmount, "#.##"),       text_color=color.white, text_size=size.small)
    table.cell(t, 0, 7, "Shares",       text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 7, str.tostring(shares),                   text_color=color.aqua,  text_size=size.normal)
