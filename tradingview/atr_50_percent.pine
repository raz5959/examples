// https://mozilla.org/MPL/2.0/
// © ATR 50% / 100% Daily Levels

//@version=6
indicator("ATR 50/100 Daily Levels", overlay=true, max_lines_count=500)

// === Inputs ===
atrLength    = input.int(14, "ATR Period", minval=1)
atrType      = input.string("SMA", "ATR Type", options=["RMA", "SMA"])
lineWidth    = input.int(2, "Line Width", minval=1, maxval=4)
atr50Color   = input.color(color.new(color.yellow, 0), "50% ATR Color")
atr100Color  = input.color(color.new(color.red, 0), "100% ATR Color")
ma20Color    = input.color(color.new(color.orange, 0), "MA 20 Color")
ma200Color   = input.color(color.new(color.purple, 0), "MA 200 Color")
riskAmount   = input.float(100, "Risk Amount ($)", minval=1)
maxTailPct   = input.float(30, "Max Tail % for Entry", minval=1, maxval=100)

prevDayColor = input.color(color.new(color.blue, 0), "Prev Day H/L Color")

// === Daily Data ===
prevClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
prevHigh  = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
prevLow   = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
atrRMA    = request.security(syminfo.tickerid, "D", ta.atr(atrLength)[1], lookahead=barmerge.lookahead_on)
atrSMA    = request.security(syminfo.tickerid, "D", ta.sma(ta.tr(true), atrLength)[1], lookahead=barmerge.lookahead_on)
dailyATR  = atrType == "SMA" ? atrSMA : atrRMA

// === 5-Min Moving Averages ===
ma20_5m  = request.security(syminfo.tickerid, "5", ta.sma(close, 20))
ma200_5m = request.security(syminfo.tickerid, "5", ta.sma(close, 200))

// === First Candle of the Day (everything calculated once here) ===
newDay = ta.change(time("D")) != 0

var float firstCandleHigh = na
var float firstCandleLow  = na
var float firstCandleSize = na
var float atr50Val        = na
var float atr100Val       = na
var float basePriceVal    = na
var bool  bullish         = false
var string scenario       = ""
var string baseSource     = ""
var float tailPct         = na
var bool  entrySignal     = false
var float firstClose      = na

var line  line50      = na
var line  line100     = na
var line  linePrevH   = na
var line  linePrevL   = na
var label lbl50       = na
var label lbl100      = na
var label lblPrevH    = na
var label lblPrevL    = na
var label lblEntry    = na

if newDay
    halfATR        = dailyATR / 2.0
    bullish        := ma20_5m > ma200_5m
    bearishGapUp   = not bullish and open > prevClose
    bullishGapDown = bullish and open < prevClose
    basePrice      = bearishGapUp ? high : bullishGapDown ? low : prevClose
    basePriceVal   := basePrice
    atr50Val       := bullish ? basePrice + halfATR  : basePrice - halfATR
    atr100Val      := bullish ? basePrice + dailyATR : basePrice - dailyATR

    // Scenario description
    gapType = open > prevClose ? "Gap Up" : open < prevClose ? "Gap Down" : "Flat"
    dir     = bullish ? "Bullish" : "Bearish"
    scenario    := dir + " / " + gapType
    baseSource  := bearishGapUp ? "1st High" : bullishGapDown ? "1st Low" : "Prev Close"

    // Reset entry until first candle completes
    entrySignal := false
    tailPct     := na

    // Delete old lines and labels
    if not na(line50)
        line.delete(line50)
    if not na(line100)
        line.delete(line100)
    if not na(lbl50)
        label.delete(lbl50)
    if not na(lbl100)
        label.delete(lbl100)
    if not na(lblEntry)
        label.delete(lblEntry)
    if not na(linePrevH)
        line.delete(linePrevH)
    if not na(linePrevL)
        line.delete(linePrevL)
    if not na(lblPrevH)
        label.delete(lblPrevH)
    if not na(lblPrevL)
        label.delete(lblPrevL)

    // Draw fixed lines
    line50  := line.new(bar_index, atr50Val,  bar_index + 1, atr50Val,  color=atr50Color,  width=lineWidth, extend=extend.right)
    line100 := line.new(bar_index, atr100Val, bar_index + 1, atr100Val, color=atr100Color, width=lineWidth, extend=extend.right)
    lbl50   := label.new(bar_index, atr50Val,  "50% " + str.tostring(atr50Val, format.mintick),  style=label.style_label_left, color=color.new(color.black, 100), textcolor=atr50Color,  size=size.normal)
    lbl100  := label.new(bar_index, atr100Val, "100% " + str.tostring(atr100Val, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=atr100Color, size=size.normal)

    // Draw previous day level: Bullish → PDH only, Bearish → PDL only
    if bullish
        linePrevH := line.new(bar_index, prevHigh, bar_index + 1, prevHigh, color=prevDayColor, width=lineWidth, style=line.style_dashed, extend=extend.right)
        lblPrevH  := label.new(bar_index, prevHigh, "PDH " + str.tostring(prevHigh, format.mintick), style=label.style_label_left, color=color.new(color.black, 100), textcolor=prevDayColor, size=size.normal)
    else
        linePrevL := line.new(bar_index, prevLow,  bar_index + 1, prevLow,  color=prevDayColor, width=lineWidth, style=line.style_dashed, extend=extend.right)
        lblPrevL  := label.new(bar_index, prevLow,  "PDL " + str.tostring(prevLow, format.mintick),  style=label.style_label_left, color=color.new(color.black, 100), textcolor=prevDayColor, size=size.normal)

// === First Candle Tail Analysis (on 2nd bar, after 1st candle is complete) ===
secondBar = newDay[1]
if secondBar
    firstCandleHigh := high[1]
    firstCandleLow  := low[1]
    firstCandleSize := high[1] - low[1]
    firstClose      := close[1]

    // Bullish: tail = upper wick (high - close), want close near high
    // Bearish: tail = lower wick (close - low), want close near low
    tail    = bullish ? (high[1] - close[1]) : (close[1] - low[1])
    tailPct := firstCandleSize > 0 ? (tail / firstCandleSize) * 100.0 : 100.0
    entrySignal := tailPct <= maxTailPct

    if not na(lblEntry)
        label.delete(lblEntry)
    if entrySignal
        lblEntry := label.new(bar_index, bullish ? low[1] : high[1],
             "ENTRY\nTail " + str.tostring(tailPct, "#.#") + "%",
             style=bullish ? label.style_label_up : label.style_label_down,
             color=color.green, textcolor=color.white, size=size.normal)

shares = firstCandleSize > 0 ? math.floor(riskAmount / firstCandleSize) : 0

// === Plot MAs ===
plot(ma20_5m, "SMA 20 (5m)", color=ma20Color, linewidth=2)
plot(ma200_5m, "SMA 200 (5m)", color=ma200Color, linewidth=2)

// === Info Table ===
if barstate.islast
    var table t = table.new(position.top_right, 2, 13, bgcolor=color.new(color.black, 80), border_width=1)
    table.cell(t, 0, 0, "Scenario",     text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 0, scenario,       text_color=bullish ? color.green : color.red, text_size=size.small)
    table.cell(t, 0, 1, "Base From",    text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 1, baseSource,     text_color=color.yellow, text_size=size.small)
    table.cell(t, 0, 2, "Base Price",   text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 2, str.tostring(basePriceVal, format.mintick), text_color=color.yellow, text_size=size.small)
    table.cell(t, 0, 3, "ATR(" + str.tostring(atrLength) + ")", text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, str.tostring(dailyATR, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "50% Level",    text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 4, str.tostring(atr50Val, format.mintick), text_color=atr50Color, text_size=size.small)
    table.cell(t, 0, 5, "100% Level",   text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 5, str.tostring(atr100Val, format.mintick), text_color=atr100Color, text_size=size.small)
    prevDayLabel = bullish ? "Prev High" : "Prev Low"
    prevDayVal   = bullish ? prevHigh : prevLow
    table.cell(t, 0, 6, prevDayLabel,   text_color=color.white,    text_size=size.small)
    table.cell(t, 1, 6, str.tostring(prevDayVal, format.mintick), text_color=prevDayColor, text_size=size.small)
    table.cell(t, 0, 7, "1st Candle",   text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 7, str.tostring(firstCandleSize, format.mintick), text_color=color.white, text_size=size.small)
    table.cell(t, 0, 8, "Tail %",       text_color=color.white,  text_size=size.small)
    tailColor = entrySignal ? color.green : color.red
    tailText  = na(tailPct) ? "waiting..." : str.tostring(tailPct, "#.#") + "%" + (bullish ? " (upper)" : " (lower)")
    table.cell(t, 1, 8, tailText, text_color=na(tailPct) ? color.gray : tailColor, text_size=size.small)
    table.cell(t, 0, 9, "Entry",        text_color=color.white,  text_size=size.small)
    entryText  = na(tailPct) ? "waiting..." : (entrySignal ? "GO" : "NO")
    entryColor = na(tailPct) ? color.gray : (entrySignal ? color.green : color.red)
    table.cell(t, 1, 9, entryText, text_color=entryColor, text_size=size.normal)
    table.cell(t, 0, 10, "Risk $",       text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 10, str.tostring(riskAmount, "#.##"),       text_color=color.white, text_size=size.small)
    table.cell(t, 0, 11, "Shares",      text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 11, str.tostring(shares),                  text_color=color.aqua,  text_size=size.normal)
    table.cell(t, 0, 12, "Direction",   text_color=color.white,  text_size=size.small)
    table.cell(t, 1, 12, bullish ? "▲ UP" : "▼ DOWN", text_color=bullish ? color.green : color.red, text_size=size.small)
